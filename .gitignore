# ---------------------------------------------------------------------------
# HibiscusXR root .gitignore
# Cross-cutting rules for the whole monorepo. Per-directory .gitignore files
# still hold directory-specific extras (e.g. named log files under
# research/notes) and are intentionally kept.
# ---------------------------------------------------------------------------


# === OS noise ==============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk


# === Editor / IDE ==========================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
*.swp
*.swo
*~
.vs/
.gradle/
.settings/
.project
.classpath
.factorypath
nbproject/
nbactions.xml
nbconfiguration.xml
.netrwhash
*.bak


# === Secrets & signing material ===========================================
# Android signing keys, certs, keystores - never commit these.
*.keystore
*.jks
*.p12
*.pk8
*.pem
*.der
*.crt
*.cer
*.key
*.gpg
*.asc
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.pub
known_hosts
authorized_keys
credentials.txt
credentials.json
secrets.json
secrets.yaml
secrets.yml
*.keystore.txt
keystore.properties
# Local-only env overrides. Tracked *.env files (e.g. system/dist/manifest.env)
# are NOT matched by these patterns.
.env
.env.local
.env.*.local
!.env.example


# === Local machine config ==================================================
local.properties
local.mk
local.sh
*.local
build.local.sh


# === Build output & dependency dirs ========================================
build/
out/
output/
bin/
obj/
dist-deps/
target/
node_modules/
bower_components/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
coverage/
htmlcov/
.tox/
.nox/
.venv/
venv/
env/
.m2/
.gradle-home/
.gradle-cache/
.cargo/
__pycache__/
*.pyc
*.pyo
*.pyd
*.class
*.tsbuildinfo
*.lockb
screenshots-out/
generated_plugin_registrant.dart


# === Android / JVM binaries ================================================
*.apk
*.apks
*.aab
*.dex
*.odex
*.vdex
*.art
*.oat
*.idsig
*.jar
*.aar
*.war
*.ear
hs_err_pid*
replay_pid*


# === Native libs & objects =================================================
*.so
*.so.*
*.a
*.o
*.ko
*.exe
*.dll
*.dylib
*.nib
*.mmap


# === Firmware / images / disk images =======================================
*.img
*.bin
*.dat
*.br
*.new
*.dtb
*.dtbo
*.fw
*.rom
*.raw
*.elf
*.spl
*.bootimg
*.super.img
*.vbmeta
*.vbmeta.img


# === Archives ==============================================================
*.zip
*.tar
*.tar.*
*.tgz
*.tbz2
*.gz
*.bz2
*.xz
*.zst
*.lz
*.lz4
*.7z
*.rar
*.cab
*.iso


# === Patch leftovers & merge artifacts =====================================
*.orig
*.rej
*.patched
*.patched2
*.p3
*.merge


# === Crash dumps & core files ==============================================
core
core.*
*.dump
*.heapdump
*.hprof


# === Logs (build/tool noise only) ==========================================
# NOTE: research/notes intentionally tracks reference logs; a blanket *.log is
# deliberately NOT used here. Only common tool log filenames are ignored.
build_log.txt
debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
flutter_*.log
dart_*.log
gradle-build.log
adb.log
logcat.txt
logcat-*.txt
