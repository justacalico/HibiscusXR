# Pico Neo 2 (A7B10) fstab
#
# Transcribed from /proc/mounts on the live unit, so mount points and flags match
# what the stock kernel actually does. Non-A/B: no slot suffixes anywhere.
#
# <src>                                      <mnt_point>  <type>  <mnt_flags and options>                              <fs_mgr_flags>

/dev/block/bootdevice/by-name/system         /system      ext4    ro,barrier=1,discard                                  wait,recoveryonly
/dev/block/bootdevice/by-name/vendor         /vendor      ext4    ro,barrier=1,discard                                  wait,recoveryonly
/dev/block/bootdevice/by-name/oem            /oem         ext4    ro,barrier=1                                          wait
/dev/block/bootdevice/by-name/dsp            /dsp         ext4    ro,nosuid,nodev,barrier=1                             wait
/dev/block/bootdevice/by-name/persist        /persist     ext4    nosuid,nodev,barrier=1                                wait
/dev/block/bootdevice/by-name/cache          /cache       ext4    nosuid,nodev,barrier=1                                wait,check
# VERIFIED against the real /vendor/etc/fstab.qcom. Stock uses encryptable=footer
# (optional FDE), NOT forced FBE - Pico explicitly disabled FDE for sdm845:
#   "#modify by nino for 36820: close FDE for sdm845"
# Do not "upgrade" this to fileencryption= without testing; the stock vendor has
# no FBE support wired up.
/dev/block/bootdevice/by-name/userdata       /data        ext4    noatime,nosuid,nodev,barrier=1,noauto_da_alloc,discard  wait,check,encryptable=footer

# Raw partitions - never auto-mounted, listed so recovery and the updater can
# address them by name.
/dev/block/bootdevice/by-name/modem          /firmware    vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0  wait
/dev/block/bootdevice/by-name/misc           /misc        emmc    defaults                                              defaults
/dev/block/bootdevice/by-name/boot           /boot        emmc    defaults                                              defaults
/dev/block/bootdevice/by-name/recovery       /recovery    emmc    defaults                                              defaults
/dev/block/bootdevice/by-name/dtbo           /dtbo        emmc    defaults                                              defaults
/dev/block/bootdevice/by-name/vbmeta         /vbmeta      emmc    defaults                                              defaults
/dev/block/bootdevice/by-name/splash         /splash      emmc    defaults                                              defaults

# USB OTG
/devices/platform/soc/a600000.ssusb/a600000.dwc3*        auto     auto    defaults                                      voldmanaged=usbotg:auto
