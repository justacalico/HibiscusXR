<?xml version="1.0" encoding="utf-8"?>
<!--
  Home environment for the Pico Neo 2: a NativeActivity that owns the
  physical display and renders only the scenery. All UI - panels, the app
  library, the summonable menu - lives in gitlab.neosalsa.hud, a system
  overlay drawn over this window. CoverWatch feeds the covered flag so the
  render loop can sleep while a fullscreen app owns the panel.
  Landscape is forced - the panel is a 3840x2160 landscape surface and each
  eye gets half of it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="gitlab.neosalsa.home"
    android:versionCode="5"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="29" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <!-- task polling for the covered flag -->
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <application
        android:label="PN2 Home"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:debuggable="false">

        <activity
            android:name=".PanelActivity"
            android:label="PN2 Home"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode|density"
            android:launchMode="singleTask"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="vrhome" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
