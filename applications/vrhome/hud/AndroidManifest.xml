<?xml version="1.0" encoding="utf-8"?>
<!--
  The HUD half of the shell: a persistent service owning a fullscreen
  TYPE_SYSTEM_OVERLAY window that renders the panels and the app library
  over whatever owns the physical display - the env activity, or a running
  VR game when summoned. Virtual displays and all task/input plumbing live
  in this process, so panels survive both app switches and env restarts.

  sharedUserId android.uid.system is what lets the panel displays host the
  IME: WindowManagerService refuses setShouldShowIme on a virtual display
  whose owner uid isn't system, and without it the keyboard falls back to
  the physical display and lands mono in both eyes. The stock shell does the
  same thing - stock logs show vrshell's display owned by uid 1000.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="gitlab.neosalsa.hud"
    android:sharedUserId="android.uid.system"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="29" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <!-- the shell's broadcast RPC surface (OPEN_PACKAGE, the keyboard
         link actions) only answers senders holding this permission -
         signature-level, so the platform-signed set is in and anything
         installed later is out -->
    <permission
        android:name="gitlab.neosalsa.hud.permission.SHELL"
        android:protectionLevel="signature" />

    <!-- system overlay window -->
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
    <!-- virtual displays, task moves, touch injection -->
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_STACKS" />
    <uses-permission android:name="android.permission.CAPTURE_VIDEO_OUTPUT" />
    <uses-permission android:name="android.permission.CAPTURE_SECURE_VIDEO_OUTPUT" />
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.REMOVE_TASKS" />
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <!-- lets the service enable its own accessibility key filter -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- HomeLock's persistent home pin: setHomeActivity and
         clearPackagePreferredActivities are signature-gated -->
    <uses-permission android:name="android.permission.SET_PREFERRED_APPLICATIONS" />
    <!-- dropbox crash/ANR entries behind the system-message cards;
         getNextEntry checks PACKAGE_USAGE_STATS on this build -->
    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <!-- controller pose/key channel: CVService's /sdcard/CtrlShareMem is
         group-readable by sdcard_rw, which this grant adds the app to -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- the dash's quick panel: radios, mic, volume, brightness, DND. All
         land through platform signing - the hud shares android.uid.system -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- SSID reads are location-gated on Android 10+ -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- lets us hand the keyboard surface and hide calls to the IME's
         receiver, which is gated the same way ours is -->
    <uses-permission android:name="gitlab.neosalsa.keyboard.permission.LINK" />

    <application
        android:label="@string/hud_label"
        android:hasCode="true"
        android:debuggable="false"
        android:requestLegacyExternalStorage="true">

        <service
            android:name=".HudService"
            android:exported="false"
            android:enabled="true" />

        <!-- global key filter for the summon key: gesture monitors never
             see keys on Android 10, an accessibility service does -->
        <service
            android:name=".SummonKeyService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/vrhud_accessibility" />
        </service>

        <!-- feeds Android notifications into the dash; the platform
             signature lets HudService enable it via secure settings -->
        <service
            android:name=".NotifService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- system-only: BOOT_COMPLETED still reaches a non-exported
             receiver, and nothing else can poke it -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
