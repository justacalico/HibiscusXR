#!/system/bin/sh
# Bridge the device-mode setting to the persist.pn2.dof system property.
#
# The settings app writes hibiscus_dof ("3dof" or "6dof") into
# Settings.Global. Apps cannot setprop, and init property triggers are
# what gate the pn2_qvrd tracking service - so a root daemon is the narrow
# piece that crosses, same shape as pn2-ipdd. The settings table is polled
# rather than pushed: `settings get` would spawn a JVM per poll.
#
# Missing or unparsable means 3dof: the prop feeds `on property:` triggers
# that start the tracking cameras, so an unexpected value must fail safe.

DB=/data/system/users/0/settings_global.xml
PROP=persist.pn2.dof

cur="__boot__"
while true; do
    mode=$(grep 'name="hibiscus_dof"' "$DB" 2>/dev/null \
           | sed -n 's/.*value="\([^"]*\)".*/\1/p' | head -1)
    case "$mode" in
        6dof) want=6dof ;;
        *)    want=3dof ;;
    esac
    if [ "$want" != "$cur" ]; then
        setprop "$PROP" "$want"
        cur="$want"
    fi
    sleep 0.5
done
