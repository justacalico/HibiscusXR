# Qualcomm VR Service (qvrd), which owns the tracking/passthrough cameras.
#
# airservice gets NULL from QVRServiceClient_Create because qvrd never runs. init
# DOES know the vendor definition in /vendor/etc/init/hw/init.target.rc, but that
# block has no seclabel, and init refuses it:
#
#     init: service qvrd does not have a SELinux domain defined
#
# Adding seclabel to a copy named 'qvrd' does not help - first definition wins and
# ours is discarded:
#
#     init: pn2-qvrd.rc: ignored duplicate definition of service 'qvrd'
#
# So run the same binary under a name init has not already claimed. The socket
# names are what matter to clients, and those are set by the socket directives
# rather than the service name, so /dev/socket/qvrservice* come out identical.
#
# Verified the binary itself is fine: run by hand it loads its full config
# (tracking cameras, ov6211_stereo eye camera, 800 Hz sensor) and only exits on
# SIGTERM.

# The service only runs in 6DoF device mode. persist.pn2.dof is the
# user-facing switch (Settings > Display > Device mode), mirrored from the
# settings table by pn2-dofd. In 3DoF the cameras never open and the SLAM
# tracker stays dead; clients see init.svc.pn2_qvrd=stopped and fall back
# to IMU-only poses.
#
# The persist prop restores at post-fs-data, earlier than the service's
# old class-main slot and possibly before the camera HAL is up - so the
# start trigger also waits on boot_completed. Both sides of the && are
# already true when the user flips the mode on a booted device, so the
# same trigger covers the runtime switch.

service pn2_qvrd /system/bin/qvrservice
    class main
    user system
    group system camera graphics
    socket qvrservice stream 0666 system system
    socket qvrservice_camera stream 0666 system system
    socket qvrservice_hvx_camera stream 0660 system system
    capabilities SYS_NICE
    seclabel u:r:shell:s0
    disabled

on property:persist.pn2.dof=6dof && property:sys.boot_completed=1
    start pn2_qvrd

on property:persist.pn2.dof=3dof
    stop pn2_qvrd
