<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local repo manifest for the Hibiscus LineageOS fork.

  Drop this into <tree>/.repo/local_manifests/hibiscus.xml after
  `repo init -u https://github.com/LineageOS/android.git -b lineage-17.1`,
  then `repo sync` again. It mounts this monorepo inside the source tree
  and links the Pico Neo 2 device tree where the build expects it.
-->
<manifest>
  <remote name="neosalsa" fetch="https://gitlab.com/neosalsa" />

  <project name="HibiscusXR" path="hibiscus" remote="neosalsa" revision="main">
    <linkfile src="system/android/device/pico/A7B10" dest="device/pico/A7B10" />
    <linkfile src="drivers" dest="hibiscus-drivers" />
    <linkfile src="system/hsvr" dest="vendor/hsvr" />
  </project>
</manifest>
