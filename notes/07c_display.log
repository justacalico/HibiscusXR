################ pvr.display.check.sh ################
#!/system/bin/sh
# *********************************************************************
# *            set hmd type to system                                 *
# *********************************************************************
PATH=/sbin:/system/sbin:/system/bin:/system/xbin
export PATH

old=`cat /dev/block/bootdevice/by-name/picocfg`

OLD_IFS="$IFS" 
IFS="," 
old_arr=($old)
IFS="$OLD_IFS" 

len=${#old_arr[*]}

#echo $len

if [ "$len" = "8" ];then
#	echo "pico cfg has useful value"
	echo "pico cfg has useful value" > /dev/kmsg
  if [ "${old_arr[7]}" = "xxx" ] ;then
	echo "pico cfg has xxx display type" > /dev/kmsg
	exit 0
  else
	echo "pico cfg has real display type" > /dev/kmsg
	setprop pvr.display.type ${old_arr[7]}
	exit 0
  fi
else
#	echo "pico cfg has unuseful value, so use default"
	echo "pico cfg has unuseful value, so use default" > /dev/kmsg
	exit 0
fi

exit 0

################ pvr.vrdisplay.ui.sh ################
#!/system/bin/sh
# *********************************************************************
# *            set hmd type to system                                 *
# *********************************************************************
PATH=/sbin:/system/sbin:/system/bin:/system/xbin
export PATH

para=$1

am startservice -a pvr.intent.action.vrdisplay -p com.pvr.vrdisplay --ei action_type $para

exit 0

