# Make PVRLauncher (com.pvr.launcher) the default home app.
#
# The HOME role holder lives in /data, not /system, so it cannot be baked into
# the image. Running `cmd role add-role-holder` at boot_completed covers a fresh
# /data (first flash, factory reset); the marker file keeps this from stomping
# a launcher the user picked afterwards. Stock never needs this because its own
# setup flow grants the role - our build has no such step.

service pn2_home /system/bin/sh -c "if [ ! -f /data/local/.pn2_home_done ]; then cmd role add-role-holder android.app.role.HOME com.pvr.launcher && touch /data/local/.pn2_home_done; fi"
    user root
    group root
    seclabel u:r:shell:s0
    oneshot
    disabled

on property:sys.boot_completed=1
    start pn2_home
