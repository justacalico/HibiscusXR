# Make the panel shell (gitlab.neosalsa.home) the default home app.
#
# The HOME role holder lives in /data, not /system, so it cannot be baked into
# the image. Running `cmd role add-role-holder` at boot_completed covers a fresh
# /data (first flash, factory reset); the marker file keeps this from stomping
# a launcher the user picked afterwards.
#
# The same first-boot pass disables the stock Pico homes (PVRLauncher, PVRHome,
# VRShell) so nothing else can claim display 0, and whitelists the shell for
# hidden API access - it reflects into ActivityTaskManager/InputManager for
# task adoption and touch injection.

service pn2_panels /system/bin/sh -c "if [ ! -f /data/local/.pn2_panels_done_v2 ]; then cmd role add-role-holder android.app.role.HOME gitlab.neosalsa.home; pm disable com.pvr.launcher; pm disable com.pvr.home; pm disable com.pvr.vrshell; settings put global hidden_api_blacklist_exemptions gitlab.neosalsa.home; touch /data/local/.pn2_panels_done_v2; fi"
    user root
    group root
    seclabel u:r:shell:s0
    oneshot
    disabled

on property:sys.boot_completed=1
    start pn2_panels
