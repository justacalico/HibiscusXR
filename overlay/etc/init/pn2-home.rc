# Wire up the split shell: gitlab.neosalsa.home is the HOME environment,
# gitlab.neosalsa.hud is the persistent overlay service that owns the panels.
#
# The HOME role holder lives in /data, not /system, so it cannot be baked into
# the image. Running `cmd role add-role-holder` at boot_completed covers a fresh
# /data (first flash, factory reset); the marker file keeps this from stomping
# a launcher the user picked afterwards.
#
# The same first-boot pass disables the stock Pico homes (PVRLauncher, PVRHome,
# VRShell) so nothing else can claim display 0, and whitelists both packages
# for hidden API access - they reflect into ActivityTaskManager/InputManager
# for task adoption, touch injection and the summon-key input monitor.
#
# The HUD service is started on every boot, not just the first: it owns the
# overlay window and the virtual displays, so panel tasks die with it.

service pn2_panels /system/bin/sh -c "if [ ! -f /data/local/.pn2_panels_done_v3 ]; then cmd role add-role-holder android.app.role.HOME gitlab.neosalsa.home; pm disable com.pvr.launcher; pm disable com.pvr.home; pm disable com.pvr.vrshell; settings put global hidden_api_blacklist_exemptions 'gitlab.neosalsa.home,gitlab.neosalsa.hud'; touch /data/local/.pn2_panels_done_v3; fi"
    user root
    group root
    seclabel u:r:shell:s0
    oneshot
    disabled

service pn2_hud /system/bin/am startservice -n gitlab.neosalsa.hud/.HudService
    user root
    group root
    seclabel u:r:shell:s0
    oneshot
    disabled

on property:sys.boot_completed=1
    start pn2_panels
    start pn2_hud
