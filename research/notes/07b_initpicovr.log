89:    exec /vendor/bin/sh /vendor/etc/pvr/init.pico.sh
90:    exec /vendor/bin/sh /vendor/etc/pvr/pvr.prop.default.sh
104:    start picovrserver
116:     write /sys/bus/msm_subsys/devices/subsys6/restart_level "related"
120:    write /sys/kernel/debug/mcu52840/mcu_power 1
122:    chmod 0666 /sys/devices/platform/soc/a8c000.spi/spi_master/spi1/spi1.0/picovr_gpio129
126:    chmod 0666 /sys/bus/i2c/drivers/at24/1-0050/eeprom
132:    exec /vendor/bin/sh /vendor/etc/pvr/pvr.display.swtich_eb.sh
138:    chmod 0666 /dev/i2c-eeprom
142:on post-fs-data
146:	chmod 777 /data/misc/pxr
168:    chmod 666 /dev/spidev1.0
169:    chown system system /dev/spidev1.0
172:    chmod 666 /dev/spidev2.0
173:    chown system system /dev/spidev2.0
176:    chmod 666 /dev/w25q
177:    chown system system /dev/w25q
180:    chmod 775 /persist
183:    chmod 775 /persist/pvr
184:    chmod 775 /persist/pvr/camera
187:    chmod 755 /persist/calibration
188:    chmod 755 /persist/calibration/mag
189:    chmod 755 /persist/calibration/mag/Geomagnetic_Matrix.txt
192:    chmod 666 /persist/Geomagnetic_Switch.txt
