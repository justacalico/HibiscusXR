# Per-device build matrix, sourced by the pipeline scripts. DEVICE picks a
# row: which hsvr drivers the provider activates (drivers/<name>/driver.json
# declares their own image steps and input pins) and which raw out/*.img
# names map to which published release assets.
#
# A new device = entries in each function below, a drivers/<name> manifest
# for its payload, and one more option in the build.yml device input.
#
#   neo2  Pico Neo 2 (PICOA7B10, sdm845) - full fastboot image
#   vmd   virtual device (qemu, host side is vmd/) - same base image, no
#         Pico stack; for testing the OS without a headset

device_known() {
  case "$1" in neo2|vmd) return 0 ;; *) return 1 ;; esac
}

# hsvr drivers the provider activates for the device - this selects image
# steps + input pins, not what the runtime compiles (monado always builds
# every drivers/*/monado driver; neo2 images keep answering the vmd pose
# channel either way).
device_drivers() {
  case "$1" in
    neo2) echo "pn2" ;;
    vmd)  echo "vmd" ;;
  esac
}

# raw-name:published-stem pairs (img2simg + xz appended). vmd has no
# clean/full split - the one image is the device image.
device_outputs() {
  case "$1" in
    neo2) echo "system-pn2:system-hibiscus-neo2 system-pn2-full:system-hibiscus-full-neo2" ;;
    vmd)  echo "system-vmd:system-hibiscus-vmd" ;;
  esac
}
