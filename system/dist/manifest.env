# Input package pins. Each entry is a generic package in this project's
# registry; upload-inputs.sh publishes a new version, the pin picks it up.
PIN_GSI=1
PIN_STACK=1
PIN_APPS=1
PIN_APPLIBS=1
PIN_OEM=1
PIN_LOADINGRES=1
PIN_BLOBS=2
PIN_SEETHROUGH=1

# Sources come from the monorepo checkout itself - the workflow links
# system/{tools,overlay,shim,pn2xr} and applications/{vrhome,library,
# quick-panel,settings} into $PN2_ROOT. Nothing gets cloned.

# Flutter toolchain pin - builds applications/library + applications/quick-panel
FLUTTER_VERSION=3.44.6
