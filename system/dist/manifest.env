# Input package pins. Each entry is a generic package in this project's
# registry; upload-inputs.sh publishes a new version, the pin picks it up.
PIN_GSI=1
PIN_STACK=1
PIN_APPS=1
PIN_APPLIBS=1
PIN_OEM=1
PIN_LOADINGRES=1
PIN_BLOBS=3
PIN_SEETHROUGH=1

# Sources come from the monorepo checkout itself - scripts/layout-sources.sh
# copies them into $PN2_ROOT (both the workflow and local runs go through
# it). Nothing gets cloned.

# Flutter toolchain pin - builds the applications/* Flutter apps
FLUTTER_VERSION=3.44.6
