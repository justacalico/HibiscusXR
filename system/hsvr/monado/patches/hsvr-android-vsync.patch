+#ifdef XRT_OS_ANDROID
+static void
+android_vsync_cb(int64_t frame_time_ns, void *data)
+{
+	struct comp_target_swapchain *cts = data;
+
+	os_thread_helper_lock(&cts->vblank.event_thread);
+	cts->vblank.last_vblank_ns = frame_time_ns;
+	os_thread_helper_unlock(&cts->vblank.event_thread);
+
+	AChoreographer_postFrameCallback(AChoreographer_getInstance(), android_vsync_cb, cts);
+}
+
+static void *
+run_android_vsync_thread(void *ptr)
+{
+	struct comp_target_swapchain *cts = ptr;
+
+	os_thread_helper_name(&cts->vblank.event_thread, "Android VSync");
+	ALooper_prepare(ALOOPER_PREPARE_ALLOW_NON_CALLBACKS);
+
+	os_thread_helper_lock(&cts->vblank.event_thread);
+	cts->vblank.thread_running = true;
+	cts->vblank.should_wait = true;
+	cts->vblank.event_active = true;
+	os_thread_helper_unlock(&cts->vblank.event_thread);
+
+	AChoreographer_postFrameCallback(AChoreographer_getInstance(), android_vsync_cb, cts);
+	while (os_thread_helper_is_running(&cts->vblank.event_thread)) {
+		ALooper_pollOnce(200, NULL, NULL, NULL);
+	}
+
+	return NULL;
+}
+#endif
