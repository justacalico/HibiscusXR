diff --git i/src/xrt/drivers/CMakeLists.txt w/src/xrt/drivers/CMakeLists.txt
index 5ec9910..7fd3012 100644
--- i/src/xrt/drivers/CMakeLists.txt
+++ w/src/xrt/drivers/CMakeLists.txt
@@ -526,6 +526,26 @@ if(XRT_BUILD_DRIVER_ANDROID)
 	list(APPEND ENABLED_DRIVERS android)
 endif()
 
+# drv_hsvr is the driver kit: kit core + the hsvr prober + every device
+# driver the build copied in from drivers/<name>/monado/. Sources are
+# globbed so adding a device never touches this file - the generated
+# hsvr_drivers.c links each driver's hsvr_drv_<name> into the table.
+if(XRT_BUILD_DRIVER_HSVR)
+	file(GLOB HSVR_SOURCES hsvr/*.c hsvr/*.h)
+	add_library(drv_hsvr STATIC ${HSVR_SOURCES})
+	target_link_libraries(
+		drv_hsvr
+		PRIVATE
+			xrt-interfaces
+			aux_util
+			aux_os
+			aux_math
+			${ANDROID_LIBRARY}
+			${CMAKE_DL_LIBS}
+	)
+	list(APPEND ENABLED_HEADSET_DRIVERS hsvr)
+endif()
+
 if(XRT_BUILD_DRIVER_ILLIXR)
 	add_library(
 		drv_illixr STATIC
