+
+static void
+target_destroy(struct comp_target *ct)
+{
+	struct comp_window_drm *w = (struct comp_window_drm *)ct;
+	struct vk_bundle *vk = &w->base.c->base.vk;
+
+	u_var_remove_root(w);
+
+	if (w->has_init_vulkan) {
+		vk->vkDeviceWaitIdle(vk->device);
+
+		if (w->staging_map != NULL) {
+			vk->vkUnmapMemory(vk->device, w->staging_mem);
+		}
+		if (w->staging != VK_NULL_HANDLE) {
+			vk->vkDestroyBuffer(vk->device, w->staging, NULL);
+			vk->vkFreeMemory(vk->device, w->staging_mem, NULL);
+		}
+		if (w->dst_image != VK_NULL_HANDLE) {
+			vk->vkDestroyImage(vk->device, w->dst_image, NULL);
+			vk->vkFreeMemory(vk->device, w->dst_mem, NULL);
+		}
+		if (ct->semaphores.render_complete != VK_NULL_HANDLE) {
+			vk->vkDestroySemaphore(vk->device, ct->semaphores.render_complete, NULL);
+		}
+		if (w->fence != VK_NULL_HANDLE) {
+			vk->vkDestroyFence(vk->device, w->fence, NULL);
+		}
+		vk_cmd_pool_destroy(vk, &w->pool);
+
+		comp_scratch_single_images_free(&w->target, vk);
+		w->has_init_vulkan = false;
+		w->base.image_count = 0;
+		w->base.images = NULL;
+	}
+
+	if (w->fd >= 0) {
+		free_fb(w);
+		close(w->fd);
+	}
+
+	comp_scratch_single_images_destroy(&w->target);
+	u_pc_destroy(&w->upc);
+
+	free(w);
+}
+
+static struct comp_target *
+target_create(struct comp_compositor *c, int fd, uint32_t conn_id, uint32_t crtc_id, drmModeModeInfo mode, const char *card)
+{
+	struct comp_window_drm *w = U_TYPED_CALLOC(struct comp_window_drm);
+
+	w->base.name = "drm";
+	w->base.init_pre_vulkan = target_init_pre_vulkan;
+	w->base.init_post_vulkan = target_init_post_vulkan;
+	w->base.check_ready = target_check_ready;
+	w->base.create_images = target_create_images;
+	w->base.has_images = target_has_images;
+	w->base.acquire = target_acquire;
+	w->base.present = target_present;
+	w->base.wait_for_present = target_wait_for_present;
+	w->base.flush = target_flush;
+	w->base.calc_frame_pacing = target_calc_frame_pacing;
+	w->base.mark_timing_point = target_mark_timing_point;
+	w->base.update_timings = target_update_timings;
+	w->base.info_gpu = target_info_gpu;
+	w->base.set_title = target_set_title;
+	w->base.queue_supports_present = target_queue_supports_present;
+	w->base.is_shared_presentable_image = target_is_shared_presentable_image;
+	w->base.destroy = target_destroy;
+	w->base.c = c;
+
+	w->base.wait_for_present_supported = false;
+	w->base.present_load_op = VK_ATTACHMENT_LOAD_OP_CLEAR;
+
+	w->fd = fd;
+	w->conn_id = conn_id;
+	w->crtc_id = crtc_id;
+	w->mode = mode;
+	snprintf(w->card, sizeof(w->card), "%s", card);
+
+	int64_t now_ns = os_monotonic_get_ns();
+	u_pc_fake_create(c->settings.nominal_frame_interval_ns, now_ns, &w->upc);
+
+	comp_scratch_single_images_init(&w->target);
+
+	w->index = -1;
+
+	u_var_add_root(w, "Compositor output", true);
+	u_var_add_native_images_debug(w, &w->target.unid, "Image");
+
+	return &w->base;
+}
+
+
+/*
+ *
+ * Factory
+ *
+ */
+
+static bool
+factory_detect(const struct comp_target_factory *ctf, struct comp_compositor *c)
+{
+	char card[64];
+	int fd = -1;
+	uint32_t conn_id = 0, crtc_id = 0;
+	drmModeModeInfo mode = {0};
+
+	if (!probe_any_card(c, card, &fd, &conn_id, &crtc_id, &mode)) {
+		return false;
+	}
+	close(fd);
+
+	return true;
+}
+
+static bool
+factory_create_target(const struct comp_target_factory *ctf, struct comp_compositor *c, struct comp_target **out_ct)
+{
+	char card[64];
+	int fd = -1;
+	uint32_t conn_id = 0, crtc_id = 0;
+	drmModeModeInfo mode = {0};
+
+	if (!probe_any_card(c, card, &fd, &conn_id, &crtc_id, &mode)) {
+		return false;
+	}
+
+	struct comp_target *ct = target_create(c, fd, conn_id, crtc_id, mode, card);
+	if (ct == NULL) {
+		close(fd);
+		return false;
+	}
+
+	COMP_INFO(c, "Using DRM/KMS target on %s connector %u (%ux%u)", card, conn_id, mode.hdisplay,
+	          mode.vdisplay);
+
+	*out_ct = ct;
+
+	return true;
+}
+
+const struct comp_target_factory comp_target_factory_drm = {
+    .name = "DRM/KMS",
+    .identifier = "drm",
+    .requires_vulkan_for_create = false,
+    .is_deferred = false,
+    .required_instance_version = 0,
+    .required_instance_extensions = NULL,
+    .required_instance_extension_count = 0,
+    .optional_device_extensions = NULL,
+    .optional_device_extension_count = 0,
+    .detect = factory_detect,
+    .create_target = factory_create_target,
+};
