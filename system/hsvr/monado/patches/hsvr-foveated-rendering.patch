+// Copyright 2026, Hibiscus
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  XR_FB_foveation entrypoints: profiles and swapchain state updates.
+ * @ingroup oxr_api
+ */
+
+#include "oxr_objects.h"
+#include "oxr_logger.h"
+#include "oxr_chain.h"
+#include "oxr_api_funcs.h"
+#include "oxr_api_verify.h"
+#include "oxr_swapchain_common.h"
+#include "oxr_xret.h"
+
+#include "util/u_debug.h"
+#include "util/u_trace_marker.h"
+#include "util/u_misc.h"
+
+#ifdef OXR_HAVE_FB_foveation
+
+static XrResult
+destroy_foveation_profile(struct oxr_logger *log, struct oxr_handle_base *hb)
+{
+	free(hb);
+	return XR_SUCCESS;
+}
+
+XrResult
+oxr_xrCreateFoveationProfileFB(XrSession session,
+                               const XrFoveationProfileCreateInfoFB *createInfo,
+                               XrFoveationProfileFB *out_profile)
+{
+	OXR_TRACE_MARKER();
+
+	struct oxr_session *sess;
+	struct oxr_logger log;
+	OXR_VERIFY_SESSION_AND_INIT_LOG(&log, session, sess, "xrCreateFoveationProfileFB");
+	OXR_VERIFY_SESSION_NOT_LOST(&log, sess);
+	OXR_VERIFY_ARG_TYPE_AND_NOT_NULL(&log, createInfo, XR_TYPE_FOVEATION_PROFILE_CREATE_INFO_FB);
+	OXR_VERIFY_ARG_NOT_NULL(&log, out_profile);
+
+	const XrFoveationLevelProfileCreateInfoFB *level = OXR_GET_INPUT_FROM_CHAIN(
+	    createInfo, XR_TYPE_FOVEATION_LEVEL_PROFILE_CREATE_INFO_FB, XrFoveationLevelProfileCreateInfoFB);
+
+	struct oxr_foveation_profile *profile = NULL;
+	OXR_ALLOCATE_HANDLE_OR_RETURN(&log, profile, OXR_XR_DEBUG_FOVPROF, destroy_foveation_profile, &sess->handle);
+	profile->sess = sess;
+	profile->xrt.level = level != NULL ? (int32_t)level->level : 3;
+	profile->xrt.vertical_offset = level != NULL ? level->verticalOffset : 0.0f;
+
+	*out_profile = oxr_foveation_profile_to_openxr(profile);
+
+	return oxr_session_success_result(sess);
+}
+
+XrResult
+oxr_xrDestroyFoveationProfileFB(XrFoveationProfileFB foveationProfile)
+{
+	OXR_TRACE_MARKER();
+
+	struct oxr_foveation_profile *profile;
+	struct oxr_logger log;
+	OXR_VERIFY_FOVEATION_PROFILE_AND_INIT_LOG(&log, foveationProfile, profile, "xrDestroyFoveationProfileFB");
+
+	return oxr_handle_destroy(&log, &profile->handle);
+}
+
+#endif // OXR_HAVE_FB_foveation
+
+#ifdef OXR_HAVE_FB_swapchain_update_state
+
+XrResult
+oxr_xrUpdateSwapchainFB(XrSwapchain swapchain, const XrSwapchainStateBaseHeaderFB *state)
+{
+	OXR_TRACE_MARKER();
+
+	struct oxr_swapchain *sc;
+	struct oxr_logger log;
+	OXR_VERIFY_SWAPCHAIN_AND_INIT_LOG(&log, swapchain, sc, "xrUpdateSwapchainFB");
+	OXR_VERIFY_SESSION_NOT_LOST(&log, sc->sess);
+	OXR_VERIFY_ARG_NOT_NULL(&log, state);
+
+	if (state->type != XR_TYPE_SWAPCHAIN_STATE_FOVEATION_FB) {
+		return oxr_error(&log, XR_ERROR_VALIDATION_FAILURE, "(state->type) is not a foveation state");
+	}
+	if ((sc->foveation_flags & XR_SWAPCHAIN_CREATE_FOVEATION_FRAGMENT_DENSITY_MAP_BIT_FB) == 0) {
+		return oxr_error(&log, XR_ERROR_VALIDATION_FAILURE,
+		                 "(swapchain) was not created with XR_SWAPCHAIN_CREATE_FOVEATION_FRAGMENT_DENSITY_MAP_BIT_FB");
+	}
+
+	const XrSwapchainStateFoveationFB *fov = (const XrSwapchainStateFoveationFB *)state;
+
+	struct xrt_foveation_profile xp = XRT_STRUCT_INIT;
+	xp.level = 3;
+
+	if (fov->profile != XR_NULL_HANDLE) {
+		struct oxr_foveation_profile *profile =
+		    XRT_CAST_OXR_HANDLE_TO_PTR(struct oxr_foveation_profile *, fov->profile);
+		if (profile->handle.debug != OXR_XR_DEBUG_FOVPROF ||
+		    profile->handle.state != OXR_HANDLE_STATE_LIVE) {
+			return oxr_error(&log, XR_ERROR_HANDLE_INVALID, "(state->profile)");
+		}
+		xp = profile->xrt;
+	}
+
+	sc->foveation = xp;
+	sc->foveation_bound = true;
+
+	return oxr_session_success_result(sc->sess);
+}
+
+#endif // OXR_HAVE_FB_swapchain_update_state
