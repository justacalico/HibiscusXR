--- a/src/xrt/auxiliary/util/u_foveation.h
+++ b/src/xrt/auxiliary/util/u_foveation.h
@@ -0,0 +1,85 @@
+// Copyright 2026, Hibiscus
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  Fixed foveated rendering: runtime gate + shared radial profile math.
+ *
+ * The feature flag is hsvr-ffrd's persist.hsvr.ffr on Android (mirrored from
+ * the hibiscus_xp_ffr Settings.Global key), HSVR_FFR elsewhere.
+ * @ingroup aux_util
+ */
+
+#pragma once
+
+#include "xrt/xrt_config_os.h"
+
+#include <math.h>
+#include <stdbool.h>
+#include <string.h>
+
+#ifdef XRT_OS_ANDROID
+#include <sys/system_properties.h>
+#else
+#include <stdlib.h>
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+static inline bool
+u_foveation_enabled(void)
+{
+#ifdef XRT_OS_ANDROID
+	char buf[PROP_VALUE_MAX] = {0};
+	return __system_property_get("persist.hsvr.ffr", buf) > 0 && buf[0] == '1';
+#else
+	const char *v = getenv("HSVR_FFR");
+	return v != NULL && v[0] == '1';
+#endif
+}
+
+/*!
+ * Radial falloff of one foveation level: full density inside @p plateau,
+ * then linear down to @p minimum at slope @p gain. r is normalized so the
+ * screen edge midpoint is ~1.0 and the corners reach ~1.41.
+ */
+struct u_foveation_level
+{
+	float plateau;
+	float gain;
+	float minimum;
+};
+
+static inline struct u_foveation_level
+u_foveation_level_params(int32_t level)
+{
+	// Ordered like XrFoveationLevelFB (0=none, 1=low, 2=medium, 3=high).
+	static const struct u_foveation_level presets[] = {
+	    {1.0f, 0.0f, 1.0f},     // none: flat
+	    {0.50f, 2.0f, 0.25f},   // low
+	    {0.35f, 3.0f, 0.125f},  // medium
+	    {0.22f, 4.5f, 0.0625f}, // high
+	};
+	if (level < 0) {
+		level = 0;
+	}
+	if (level > 3) {
+		level = 3;
+	}
+	return presets[level];
+}
+
+static inline float
+u_foveation_density(float r, const struct u_foveation_level *p)
+{
+	float d = 1.0f - p->gain * fmaxf(0.0f, r - p->plateau);
+	if (d < p->minimum) {
+		d = p->minimum;
+	}
+	return d > 1.0f ? 1.0f : d;
+}
+
+#ifdef __cplusplus
+}
+#endif
