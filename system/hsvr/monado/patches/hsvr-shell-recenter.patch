diff --git a/src/xrt/state_trackers/oxr/oxr_shell.h b/src/xrt/state_trackers/oxr/oxr_shell.h
new file mode 100644
--- /dev/null
+++ b/src/xrt/state_trackers/oxr/oxr_shell.h
@@ -0,0 +1,42 @@
+// Copyright 2026, Hibiscus
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief Shell signal channel for the in-process runtime.
+ *
+ * The system shell bumps the sys.hsvr.recenter property on its recenter
+ * gesture; every runtime process watches it and recenters the local
+ * spaces so the gesture reaches running sessions. The value is a stamp,
+ * not a state: an instance adopts whatever is there at system init and
+ * only reacts to changes after that.
+ *
+ * @ingroup oxr_main
+ */
+
+#pragma once
+
+#include "xrt/xrt_config_os.h"
+
+#ifdef XRT_OS_ANDROID
+#include <sys/system_properties.h>
+#endif
+
+#include <stdint.h>
+#include <stdlib.h>
+
+
+#define OXR_SHELL_RECENTER_PROP "sys.hsvr.recenter"
+
+static inline uint64_t
+oxr_shell_recenter_signal(void)
+{
+#ifdef XRT_OS_ANDROID
+	char buf[PROP_VALUE_MAX] = {0};
+	if (__system_property_get(OXR_SHELL_RECENTER_PROP, buf) <= 0) {
+		return 0;
+	}
+	return strtoull(buf, NULL, 10);
+#else
+	return 0;
+#endif
+}
