# Generic headset profile: any standalone headset whose kernel exposes
# the standard interfaces. No vendor blobs: IIO for the IMU, evdev for
# controller HID, V4L2 for the eye tracking camera. Node names are the
# only device-specific values - override to match a device's tree.
HSVC_SVC_NAMES="imu eye ctrl0 ctrl1"
HSVC_IMU_BIN="/usr/bin/hsvc-imu"
HSVC_IMU_ARGS="--iio 0"
HSVC_EYE_BIN="/usr/bin/hsvc-eye"
HSVC_EYE_ARGS="--device /dev/video0"
HSVC_CTRL0_BIN="/usr/bin/hsvc-ctrl"
HSVC_CTRL0_ARGS="--evdev /dev/input/event0 --index 0"
HSVC_CTRL1_BIN="/usr/bin/hsvc-ctrl"
HSVC_CTRL1_ARGS="--evdev /dev/input/event1 --index 1"
