# PC profile where a mouse plays the headset: hsvc-vmd turns relative
# motion into a 3-dof head pose and clicks into the trigger, so the
# real stack can be driven by hand. "auto" picks the first mouse-ish
# evdev node; pin an explicit /dev/input/eventN if a box needs it.
HSVC_SVC_NAMES="vmd"
HSVC_VMD_BIN="/usr/bin/hsvc-vmd"
HSVC_VMD_ARGS="--evdev auto"
