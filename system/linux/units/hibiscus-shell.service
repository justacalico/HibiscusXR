[Unit]
Description=Hibiscus shell (dash, OpenXR overlay)
After=monado.service
Requires=monado.service

[Service]
Environment=XDG_RUNTIME_DIR=/run/hibiscus-shell
Environment=XR_RUNTIME_JSON=/etc/openxr/1/active_runtime.json
RuntimeDirectory=hibiscus-shell
ExecStart=/usr/bin/dash-wayland -vr
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
