[Unit]
Description=Hibiscus shell (dash, OpenXR overlay)
After=monado.service
Requires=monado.service

[Service]
Environment=XDG_RUNTIME_DIR=/run/hibiscus
Environment=XR_RUNTIME_JSON=/etc/openxr/1/active_runtime.json
Environment=LIBGL_DRIVERS_PATH=/usr/lib/hibiscus/dri
RuntimeDirectory=hibiscus
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/dash-wayland -vr
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
