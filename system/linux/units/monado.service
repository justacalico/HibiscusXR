[Unit]
Description=Monado OpenXR runtime (hsvc-backed)
After=hsvcd.service
Requires=hsvcd.service

[Service]
ExecStart=/usr/bin/monado-service
Environment=XRT_NO_STDIN=1
Environment=XDG_RUNTIME_DIR=/run/hibiscus
Environment=XDG_CONFIG_HOME=/run/hibiscus
Environment=XRT_COMPOSITOR_TARGET=drm
RuntimeDirectory=hibiscus
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
