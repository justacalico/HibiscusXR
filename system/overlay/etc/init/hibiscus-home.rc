# Wire up the split shell: gitlab.neosalsa.home is the HOME environment,
# gitlab.neosalsa.hud is the persistent overlay service that owns the panels.
#
# The HOME role holder lives in /data, not /system, so it cannot be baked into
# the image. Running `cmd role add-role-holder` at boot_completed covers a fresh
# /data (first flash, factory reset).
#
# The role write alone is a regular preference, and the framework clears
# regular home prefs the moment another launcher installs - that is what makes
# the "switch home app" chooser appear. hibiscus_homelock therefore runs on
# every boot and pins HOME with `cmd package set-home-activity`, which writes a
# persistent preferred activity: the one preference class installs can never
# clear, so the chooser has no state in which it can come up. At runtime the
# HUD's HomeLock re-pins the same way whenever the resolved home drifts (the
# Settings > Default apps role path rewrites the pref), so switching home is
# impossible for anything short of root.
#
# The same first-boot pass disables the stock Pico homes (PVRLauncher, PVRHome,
# VRShell) so nothing else can claim display 0, plus Provision - the setup
# wizard the stock launcher keeps starting, which crashes in its language
# picker and churns the foreground - and whitelists the shell packages for
# hidden API access - the shell reflects into ActivityTaskManager/InputManager
# for task adoption, touch injection, the summon-key input monitor and
# BluetoothDevice.removeBond for in-app unpairing.
#
# It also sweeps the retired Flutter shell apps (settings, quick panel,
# library) out of /data: hibiscus-appsweep uninstalls each only when its
# signing cert matches the platform key, so installs that are not ours are
# left alone. It only exists on images that ship it, so the call is gated on
# the binary being there.
#
# Notification listener access goes through `cmd notification allow_listener`
# rather than a settings write: this build's NotificationManagerService does
# not pick up enabled_notification_listeners changes made from app code, but
# the shell command both writes the setting and rebinds the service. The HUD
# needs it to draw shade cards in VR.
#
# The HUD service is started on every boot, not just the first: it owns the
# overlay window and the virtual displays, so panel tasks die with it.

service hibiscus_panels /system/bin/sh -c "if [ ! -f /data/local/.hibiscus_panels_done_v1 ]; then ok=1; cmd role add-role-holder android.app.role.HOME gitlab.neosalsa.home || ok=0; for p in com.pvr.launcher com.pvr.home com.pvr.vrshell com.picovr.provision; do if pm path $p 2>/dev/null | grep -q .; then pm disable $p || ok=0; fi; done; settings put global hidden_api_blacklist_exemptions 'gitlab.neosalsa.home,gitlab.neosalsa.hud' || ok=0; pm grant gitlab.neosalsa.home android.permission.CAMERA || ok=0; cmd notification allow_listener gitlab.neosalsa.hud/gitlab.neosalsa.hud.NotifService 0 || ok=0; [ ! -x /system/bin/hibiscus-appsweep ] || /system/bin/hibiscus-appsweep; [ $ok = 1 ] && touch /data/local/.hibiscus_panels_done_v1; fi"
    user root
    group root
    seclabel u:r:shell:s0
    oneshot
    disabled

service hibiscus_homelock /system/bin/cmd package set-home-activity gitlab.neosalsa.home/.PanelActivity
    user root
    group root
    seclabel u:r:shell:s0
    oneshot
    disabled

service hibiscus_hud /system/bin/am startservice -n gitlab.neosalsa.hud/.HudService
    user root
    group root
    seclabel u:r:shell:s0
    oneshot
    disabled

on property:sys.boot_completed=1
    start hibiscus_panels
    start hibiscus_homelock
    start hibiscus_hud
