diff --git i/src/xrt/compositor/main/comp_compositor.c w/src/xrt/compositor/main/comp_compositor.c
index a8fbd01d..5e88f8c8 100644
--- i/src/xrt/compositor/main/comp_compositor.c
+++ w/src/xrt/compositor/main/comp_compositor.c
@@ -1136,6 +1136,20 @@ comp_main_create_system_compositor(struct xrt_device *xdev,
 
 	c->frame_interval_ns = c->settings.nominal_frame_interval_ns;
 
+#ifdef XRT_OS_ANDROID
+	// The driver only guesses a nominal rate while the whole fake pacing
+	// grid is anchored on this interval: SurfaceFlinger's reported mode
+	// rate is the only truthful value to pace against.
+	{
+		float refresh_hz = android_custom_surface_get_display_refresh_rate(
+		    android_globals_get_vm(), android_globals_get_context());
+		if (refresh_hz > 1.0f) {
+			c->frame_interval_ns = time_s_to_ns(1.0f / refresh_hz);
+			c->settings.nominal_frame_interval_ns = c->frame_interval_ns;
+		}
+	}
+#endif
+
 	c->last_frame_time_ns = os_monotonic_get_ns();
 
 	double scale = c->settings.viewport_scale;
