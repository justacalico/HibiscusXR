 	    UINT64_MAX,                            // timeout
-	    cts->base.semaphores.present_complete, // semaphore
+	    acquire_sem,                           // semaphore
 	    VK_NULL_HANDLE,                        // fence
 	    out_index);                            // pImageIndex
 	VK_CHK_AND_RET(ret, "vkAcquireNextImageKHR");
