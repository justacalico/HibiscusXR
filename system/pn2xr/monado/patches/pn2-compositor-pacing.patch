 		COMP_DEBUG(r->c, "Received %s.", vk_result_string(ret));
 
+		// Acquires also run while the previous frame is still in flight:
+		// drain it before the recreate destroys the target resources.
+		renderer_wait_queue_idle(r);
+
 		if (!renderer_ensure_images_and_renderings(r, true)) {
 			// Failed on force recreate.
 			COMP_ERROR(r->c,
@@ -1230,6 +1242,17 @@ comp_renderer_draw(struct comp_renderer *r)
 		    rect);                     //
 	}
 
+	/*
+	 * Wait for a free target image before draining the queue. On targets
+	 * without present-wait support this blocks until scanout releases an
+	 * image at the next display flip, so doing it while the submitted
+	 * work is still in flight lets the GPU drain overlap the wait instead
+	 * of serialising behind it.
+	 */
+	if (present_success) {
+		renderer_wait_for_present(r, desired_present_time_ns);
+	}
