+		preferred_at_least_image_count = 3;
+	}
 
 	// Get the image count.
 	uint32_t image_count = select_image_count(cts, surface_caps, preferred_at_least_image_count);
@@ -963,11 +976,21 @@ comp_target_swapchain_acquire_next_image(struct comp_target *ct, uint32_t *out_i
 	}
 #endif
 
+	/*
+	 * Fake-timing targets re-acquire the next image while the previous
+	 * frame is still in flight. Signalling present_complete a second time
+	 * here would violate binary semaphore rules, so acquire without one:
+	 * the call blocks until the image is usable, making it unnecessary.
+	 */
+	VkSemaphore acquire_sem = cts->timing_usage == COMP_TARGET_FORCE_FAKE_DISPLAY_TIMING
+	                              ? VK_NULL_HANDLE
+	                              : cts->base.semaphores.present_complete;
+
 	VkResult ret = vk->vkAcquireNextImageKHR(  //
